# Sample environment configuration for local test database only
# Production credentials or secrets are strictly forbidden here
DATABASE_URL="postgresql://postgres:postgres_sample_dev_pw@127.0.0.1:54332/multiplatformmsg_test?schema=public"

# ==============================================================================
# Dedicated Test Database Safety Marker
# ==============================================================================
# The integration test suite enforces a fail-closed guard against non-test databases.
# It requires the target test database to be pre-provisioned with a dedicated safety
# marker and matching runtime token. The test code strictly SELECTs and verifies;
# it never creates or inserts markers.
#
# Before running tests against a fresh dedicated test database:
# 1. Generate a dedicated runtime token:
#      export TEST_DATABASE_MARKER_TOKEN=$(node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
#
# 2. Provision the safety marker using safe parameterized psql variables (no raw string concatenation):
#      psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -v token="$TEST_DATABASE_MARKER_TOKEN" <<'EOF'
#        CREATE TABLE IF NOT EXISTS "__multiplatformmsg_test_marker__" (
#          "marker_key" TEXT PRIMARY KEY,
#          "marker_token" TEXT NOT NULL,
#          "created_at" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP
#        );
#        INSERT INTO "__multiplatformmsg_test_marker__" ("marker_key", "marker_token")
#        VALUES ('TEST_ENVIRONMENT_PERMITTED', :'token')
#        ON CONFLICT ("marker_key") DO UPDATE SET "marker_token" = EXCLUDED."marker_token";
#      EOF
# ==============================================================================
TEST_DATABASE_MARKER_TOKEN=""
