datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id        String   @id @default(uuid())
  name      String   @map("name")
  slug      String   @unique @map("slug")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brands             Brand[]
  staff              Staff[]
  teams              Team[]
  staffTeams         StaffTeam[]
  sessions           Session[]
  contacts           Contact[]
  tags               Tag[]
  contactTags        ContactTag[]
  suppressionEntries SuppressionEntry[]

  @@map("tenants")
}

model Brand {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String   @map("name")
  code      String?  @map("code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("brands")
}

model Staff {
  id                  String      @id @default(uuid())
  tenantId            String      @map("tenant_id")
  email               String      @map("email")
  fullName            String      @map("full_name")
  role                String      @default("MEMBER") @map("role")
  status              String      @default("ACTIVE") @map("status")
  username            String?     @map("username")
  passwordHash        String?     @map("password_hash")
  failedLoginAttempts Int         @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?   @map("locked_until")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffTeams StaffTeam[]
  sessions   Session[]

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([tenantId])
  @@map("staff")
}

model Team {
  id          String      @id @default(uuid())
  tenantId    String      @map("tenant_id")
  name        String      @map("name")
  description String?     @map("description")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffTeams StaffTeam[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("teams")
}

model StaffTeam {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  staffId   String   @map("staff_id")
  teamId    String   @map("team_id")
  role      String?  @map("role")
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff     Staff    @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)
  team      Team     @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, staffId, teamId])
  @@index([tenantId])
  @@map("staff_teams")
}

model Session {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  staffId   String    @map("staff_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, staffId])
  @@index([tokenHash])
  @@map("sessions")
}

model Contact {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  phoneNormalized String       @map("phone_normalized")
  phoneRaw        String?      @map("phone_raw")
  firstName       String?      @map("first_name")
  lastName        String?      @map("last_name")
  attributes      Json?        @map("attributes")
  isSuppressed    Boolean      @default(false) @map("is_suppressed")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactTags ContactTag[]

  @@unique([tenantId, id])
  @@unique([tenantId, phoneNormalized])
  @@index([tenantId])
  @@index([tenantId, phoneNormalized])
  @@map("contacts")
}

model Tag {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  name        String       @map("name")
  color       String?      @map("color")
  description String?      @map("description")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactTags ContactTag[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tags")
}

model ContactTag {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  contactId String   @map("contact_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tenantId, tagId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, contactId, tagId])
  @@index([tenantId])
  @@index([tenantId, contactId])
  @@index([tenantId, tagId])
  @@map("contact_tags")
}

model SuppressionEntry {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  phoneNormalized String   @map("phone_normalized")
  reason          String?  @map("reason")
  source          String?  @map("source")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, phoneNormalized])
  @@index([tenantId])
  @@index([tenantId, phoneNormalized])
  @@map("suppression_entries")
}